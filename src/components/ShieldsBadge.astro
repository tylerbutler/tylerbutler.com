---
/**
 * A shields.io-style two-tone badge — dark label side, colored value side,
 * white text, 3px corners — rendered natively rather than by badge-maker.
 *
 * Keeping the familiar README badge form, but not its typography or palette:
 * badge-maker baked Verdana and #4c1/#555/#9f9f9f into SVG attributes, so the
 * badges could follow neither CSS nor the light/dark toggle. Here the grounds
 * come from the site palette and every pair is checked against white text.
 *
 * `logo` still takes the data URI from languageBadge() in lib/badges.ts, and
 * `valueBg` its brand `color`, so that module is unchanged.
 */
type Tone = "neutral" | "success" | "warning" | "muted";

interface Props {
  /** Left (dark) side, e.g. "license". Omit for a value-only badge. */
  label?: string;
  message: string;
  tone?: Tone;
  logo?: string;
  href?: string;
  /** Bare hex for the value ground — language brand colors override the tone. */
  valueBg?: string;
}

const { label, message, tone = "neutral", logo, href, valueBg } = Astro.props;

const Tag = href ? "a" : "span";
const isExternal = href?.startsWith("http") ?? false;

/**
 * Named explicitly rather than left to name-from-contents: the two sides are
 * adjacent text nodes, so contents alone announce as "licenseMIT".
 */
const accessibleName = href
  ? `${[label, message].filter(Boolean).join(" ")}${isExternal ? " (opens in new tab)" : ""}`
  : undefined;

const linkAttrs = href
  ? {
      href,
      "aria-label": accessibleName,
      ...(isExternal ? { target: "_blank", rel: "noopener" } : {}),
    }
  : {};

/**
 * Brand colors are never altered, so the text adapts to them: white where it
 * clears AA, otherwise the hull dark. Gleam's pale pink and Go's cyan take the
 * dark text; Rust, TypeScript and Python's blues take white.
 */
function readableOn(hex: string): string {
  const h = hex.replace("#", "");
  const [r, g, b] = [0, 2, 4].map((i) => {
    const s = Number.parseInt(h.slice(i, i + 2), 16) / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return 1.05 / (luminance + 0.05) >= 4.5 ? "#ffffff" : "#1a2332";
}

const valueStyle = valueBg
  ? `background:#${valueBg.replace("#", "")};color:${readableOn(valueBg)}`
  : undefined;
---

<Tag class:list={["badge", `tone-${tone}`, href && "badge-link"]} {...linkAttrs}>
  <span class="badge-label">
    {logo && <img class="badge-logo" src={logo} alt="" width="12" height="12" />}
    {label && <span>{label}</span>}
  </span>
  <span class="badge-value" style={valueStyle}>{message}</span>
</Tag>

<style>
  /* Grounds are held constant across themes, the way a README badge is — each
     is mid-dark enough to sit on both the warm white page and the void. */
  .badge {
    --label-bg: #2a4a47; /* Nebula Teal */
    --value-bg: #96591c; /* Burnt Atmosphere */

    display: inline-flex;
    align-items: stretch;
    border-radius: var(--radius-sm);
    overflow: hidden;
    font-family: Lato, "Helvetica Neue", Arial, sans-serif;
    font-size: var(--font-size-meta);
    line-height: 1;
    text-decoration: none;
    max-width: 100%;
  }

  .badge-label,
  .badge-value {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 6px;
    min-height: 20px;
    color: #ffffff;
    white-space: nowrap;
  }

  .badge-label {
    background: var(--label-bg);
  }

  .badge-value {
    background: var(--value-bg);
    font-weight: 600;
    /* The one place a long value may break rather than push past the column */
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .badge-logo {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  /* Instrument colors, darkened where needed so white text clears AA:
     success 4.9:1, warning 7.3:1, muted 6.2:1, neutral 5.6:1. */
  .tone-success {
    --value-bg: #4a7c59;
  }

  .tone-warning {
    --value-bg: #7d4b17;
  }

  .tone-muted {
    --value-bg: #4a6662;
  }

  .badge-link:hover .badge-value,
  .badge-link:focus-visible .badge-value {
    filter: brightness(1.15);
  }

  /* Touch: grow to a comfortable hit area by padding, not font size */
  @media (pointer: coarse) {
    .badge-label,
    .badge-value {
      min-height: 40px;
      padding: 0 10px;
    }
  }
</style>
