---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { ExternalLink } from "@lucide/astro";
import Github from "simple-icons-astro/Github";
import ActionChip from "../../components/ActionChip.astro";
import ProjectBadges from "../../components/ProjectBadges.astro";
import SourcePreview from "../../components/SourcePreview.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getArticleDisplayTitle,
  getArticleUrl,
  getRelatedArticles,
} from "../../lib/article-utils";
import { includeDraft } from "../../lib/draft-utils";
import { getProjectRelationships } from "../../lib/project-utils";
import { formatTitle } from "../../lib/typography";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects
    .filter(({ id, data }) => !id.startsWith("_") && includeDraft(data))
    .map((project) => ({
      params: { slug: project.id },
      props: { project, relationships: getProjectRelationships(project, projects) },
    }));
}

const { project, relationships } = Astro.props;
const relationshipSections = await Promise.all(
  [
    {
      heading: "Powered by",
      id: "powered-by",
      description: `Projects that ${project.data.title} depends on.`,
      projects: relationships.poweredBy,
    },
    {
      heading: "Powers",
      id: "powers",
      description: `Projects that use ${project.data.title} as a dependency.`,
      projects: relationships.powers,
    },
  ]
    .filter(({ projects }) => projects.length > 0)
    .map(async (section) => ({
      ...section,
      projects: await Promise.all(
        section.projects.map(async (relatedProject) => ({
          ...relatedProject,
          formattedTitle: await formatTitle(relatedProject.data.title),
        })),
      ),
    })),
);
const { Content } = await render(project);
const relatedArticles = await Promise.all(
  getRelatedArticles(
    project.data.tags?.length ? await getCollection("articles") : [],
    project.data.tags,
  ).map(async (article) => ({
    ...article,
    formattedTitle: await formatTitle(getArticleDisplayTitle(article)),
  })),
);
---

<BaseLayout
  title={`${project.data.title} - Tyler Butler`}
  description={project.data.description}
  headerSize="small"
>
  <article class="article">
    <header class="article-header">
      {project.data.logo && (
        <Image src={project.data.logo} alt={`${project.data.title} logo`} class="project-logo"/>
      )}
      <h1 set:html={await formatTitle(project.data.title)} />
      <div class="article-badges">
        <ProjectBadges
          npm={project.data.npm}
          crate={project.data.crate}
          hex={project.data.hex}
          hexDocs={project.data.hexDocs}
          license={project.data.license}
          programmingLanguage={project.data.programmingLanguage}
          maturity={project.data.maturity}
        />
      </div>
      {project.data.description && (
        <p class="project-description">{project.data.description}</p>
      )}
    </header>
    <div class="article-content">
      <Content/>
    </div>

    {project.data.tags && project.data.tags.length > 0 && (
      <div class="article-tags">
        {project.data.tags.map(tag => (
          <a href={`/tags/${tag}/`} class="tag" data-pagefind-filter="tag">#{tag}</a>
        ))}
      </div>
    )}

    {project.data.url && (
      <div class="project-previews">
        <SourcePreview url={project.data.url} />
      </div>
    )}

    <div class="project-links">
      {project.data.url && (
        <ActionChip href={project.data.url} external data-tinylytics-event="project.url" data-tinylytics-event-value={project.id}>
          <ExternalLink size={16} />
          Website
        </ActionChip>
      )}
      {project.data.github && (
        <ActionChip href={project.data.github} external data-tinylytics-event="project.github" data-tinylytics-event-value={project.id}>
          <Github size={16} />
          GitHub
        </ActionChip>
      )}
    </div>

    {relationshipSections.length > 0 && (
      <div class="project-relationships">
        {relationshipSections.map(section => (
          <section aria-labelledby={`${section.id}-heading`}>
            <h2 id={`${section.id}-heading`}>{section.heading}</h2>
            <p class="relationship-context">{section.description}</p>
            <ul>
              {section.projects.map(relatedProject => (
                <li>
                  <a href={`/projects/${relatedProject.id}/`} set:html={relatedProject.formattedTitle} />
                  {relatedProject.data.description && (
                    <p>{relatedProject.data.description}</p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )}

    {relatedArticles.length > 0 && (
      <section class="related-articles" aria-labelledby="related-articles-heading">
        <h2 id="related-articles-heading">Related Articles</h2>
        <ul>
          {relatedArticles.map(article => (
            <li>
              <a href={getArticleUrl(article)} set:html={article.formattedTitle} />
              <time datetime={article.data.date.toISOString()}>
                {article.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  /* Shared styles with articles - using same class names */
  .article {
    max-width: 100%;
  }

  .article-header {
    margin-bottom: 2em;
    border-bottom: 1px solid var(--text-light);
  }

  /* Type comes from typography.css — the family, weight and line-height here
     were identical to the global headings, and the sizes only diverged by
     being fluid where the documented ramp is flat. These rules now carry
     nothing but the article's own vertical rhythm. */
  .article h1 {
    margin: 0 0 0.5em 0;
  }

  .article-tags {
    margin: 1.5em 0;
  }

  /* Not a duplicate of the identical rule in article-page.css: that sheet is
     imported by ArticlePage.astro alone, never by global.css, so it does not
     reach this page. Sized by the meta token rather than a bare 11px. */
  .tag {
    display: inline-block;
    background: var(--code-bg);
    padding: 2px 6px;
    margin-right: 6px;
    margin-bottom: 4px;
    font-size: var(--font-size-meta);
    color: var(--text);
    border-radius: var(--radius-sm);
    text-transform: lowercase;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tag:hover {
    background: var(--accent);
    color: var(--light-bg);
  }

  .article-content {
    font-size: 16px;
    line-height: 1.6;
  }

  .article-content h2 {
    margin: 2em 0 1em 0;
  }

  .article-content h3 {
    margin: 1.5em 0 0.8em 0;
  }

  .article-content h4 {
    margin: 1.2em 0 0.6em 0;
  }

  .article-content h5 {
    margin: 1em 0 0.5em 0;
  }

  .article-content h6 {
    margin: 1em 0 0.5em 0;
  }

  .article-content p {
    font-size: clamp(15px, 2.5vw, 16px);
    line-height: 1.6;
    margin: 1em 0;
  }

  .article-content a,
  .content-inner a:not(.tag):not(.nav-link):not(.badge):not(.blank) {
    position: relative;
    text-decoration: none;
    background-image: none;
  }

  .content-inner a:not(.tag):not(.nav-link):not(.badge):not(.blank):not(#overview):hover {
    background-size: 0% 1px;
    background-position: 100% 0%;
  }

  /* Matches the card description on the projects index: body size, set apart
     by italic and the secondary ink rather than by a step off the type ramp. */
  .project-description {
    font-style: italic;
    color: var(--text-light);
    margin: 1em 0 1.5em 0;
    line-height: 1.5;
  }

  .project-previews {
    display: grid;
    gap: 1em;
    margin-top: 2em;
  }

  .project-previews:not(:has(:global(.link-preview:not(.link-preview--no-metadata)))) {
    display: none;
  }

  /* The chips style themselves in ActionChip.astro — this row only spaces them */
  .project-links {
    margin: 2em 0 0 0;
    padding-top: 1.5em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75em;
  }

  .project-logo {
    width: 96px;
    float: left;
    margin-right: 1em;
  }

  .related-articles {
    margin-top: 2em;
  }

  .project-relationships {
    margin-top: 2.5em;
    padding-top: 2em;
    border-top: 1px solid var(--code-border);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 2em;
  }

  .project-relationships section {
    min-width: 0;
  }

  .project-relationships ul {
    list-style: none;
    padding: 0;
    margin: 1em 0 0;
  }

  .project-relationships li {
    padding: 0;
    margin: 0 0 1.25em;
    overflow-wrap: anywhere;
  }

  .project-relationships li:last-child {
    margin-bottom: 0;
  }

  .project-relationships p {
    margin: 0.25em 0 0;
    color: var(--text-light);
  }

  .project-relationships .relationship-context {
    margin-top: 0.5em;
    overflow-wrap: anywhere;
  }

  .related-articles li {
    margin-bottom: 1em;
  }

  .related-articles time {
    display: block;
    color: var(--text-light);
    font-size: var(--font-size-meta);
  }
</style>
