---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticleDisplayTitle, getArticleUrl } from "../../lib/article-utils";
import { includeDraft } from "../../lib/draft-utils";
import { formatTitle } from "../../lib/typography";

// Drafts hidden unless SHOW_DRAFTS=1.
const articles = await getCollection("articles", ({ data }) =>
  includeDraft(data),
);

// Sort by date (newest first) and format titles
const sortedArticles = await Promise.all(
  articles
    .sort(
      (a, b) =>
        new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    )
    .map(async (article) => ({
      ...article,
      formattedTitle: await formatTitle(getArticleDisplayTitle(article)),
    })),
);

// Group articles by year
const articlesByYear = sortedArticles.reduce(
  (acc, article) => {
    const year = new Date(article.data.date).getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(article);
    return acc;
  },
  {} as Record<number, typeof sortedArticles>,
);

const years = Object.keys(articlesByYear)
  .map(Number)
  .sort((a, b) => b - a);

const decadeGroups = Array.from(
  years.reduce((groups, year) => {
    const decade = Math.floor(year / 10) * 10;
    const group = groups.get(decade) ?? [];
    group.push({
      year,
      count: articlesByYear[year].length,
    });
    groups.set(decade, group);
    return groups;
  }, new Map<number, { year: number; count: number }[]>()),
)
  .sort(([a], [b]) => b - a)
  .map(([decade, groupedYears]) => ({
    decade,
    years: groupedYears,
    total: groupedYears.reduce((sum, year) => sum + year.count, 0),
  }));
---

<BaseLayout
  title="Articles - Tyler Butler"
  description="All articles by Tyler Butler."
  excludeFromSearch
>
  <section>
    <h1>Articles</h1>

    <nav class="year-navigation" aria-labelledby="year-navigation-title">
      <h2 id="year-navigation-title">Browse by Decade</h2>
      <div class="decade-groups">
        {decadeGroups.map((group) => (
          <section class="decade-group" aria-labelledby={`decade-${group.decade}`}>
            <div class="decade-heading">
              <h3 id={`decade-${group.decade}`}>{group.decade}s</h3>
              <span>
                {group.total} {group.total === 1 ? "article" : "articles"}
              </span>
            </div>
            <ul class="year-nav-list">
              {group.years.map(({ year, count }) => (
                <li class="year-nav-item">
                  <a
                    href={`#${year}`}
                    class="year-nav-link"
                    aria-label={`${year}, ${count} ${count === 1 ? "article" : "articles"}`}
                  >
                    <span>{year}</span>
                    <span class="year-count">({count})</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </nav>

    <div class="articles-main">
      {years.map(year => (
        <section class="year-section" id={year.toString()}>
          <h2 class="year-heading">{year}</h2>
          <div class="articles-container">
            {articlesByYear[year].map(article => {
              const date = new Date(article.data.date);

              return (
                <article class="article-item">
                  <time class="article-date" datetime={article.data.date.toISOString()}>
                    {date.toLocaleDateString('en-US', {
                      day: '2-digit',
                      month: 'short'
                    })}
                  </time>
                  <h3 class="article-title">
                    <a href={getArticleUrl(article)} class="article-link" set:html={article.formattedTitle} />
                  </h3>
                  {article.data.excerpt && (
                    <p class="excerpt">{article.data.excerpt}</p>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .year-navigation {
    margin: 2rem 0 3rem;
  }

  .year-navigation > h2 {
    margin-bottom: 0.75em;
    font-family: "Lato", "Helvetica Neue", Arial, sans-serif;
    font-size: var(--font-size-ui);
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .decade-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .decade-group {
    min-width: 0;
  }

  .decade-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--code-border);
  }

  .decade-heading h3 {
    font-size: var(--font-size-subheading);
  }

  .decade-heading span {
    color: var(--text-light);
    font-size: var(--font-size-meta);
  }

  .year-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
  }

  .year-nav-item {
    margin: 0;
    padding: 0;
  }

  .year-nav-link {
    display: inline-flex;
    gap: 0.3em;
    color: var(--accent);
    text-decoration: none;
    font-size: var(--font-size-label);
  }

  .year-nav-link:hover {
    text-decoration: underline;
  }

  .year-count {
    color: var(--text-light);
    font-variant-numeric: tabular-nums;
  }

  .articles-main {
    margin-top: 2rem;
  }

  .year-section {
    display: flex;
    margin-bottom: 2rem;
    align-items: flex-start;
    gap: 2rem;
    scroll-margin-block-start: 1rem;
  }

  .year-heading {
    margin: 0;
    flex-shrink: 0;
    width: 120px;
    text-align: right;
    position: sticky;
    top: 0;
    align-self: flex-start;
    background: var(--light-bg);
    padding: 0.5rem 0;
    z-index: 10;
  }

  .articles-container {
    flex: 1;
  }

  .article-item {
    margin-bottom: 0.5rem;
    display: flex;
    align-items: start;
  }

  .article-date {
    flex-shrink: 0;
    width: 60px;
    font-size: var(--font-size-label);
    color: var(--text-light);
    font-variant-numeric: tabular-nums;
    text-align: left;
    align-self: center;
  }

  .article-title {
    margin: 0;
  }

  .article-link {
    color: var(--text);
    text-decoration: none;
  }

  .article-link:hover {
    color: var(--accent);
  }

  .excerpt {
    margin: 0.5em 0;
    font-size: var(--font-size-label);
    line-height: 1.6;
    color: var(--text-light);
  }

  /* Smaller headings for articles page */
  .year-heading {
    font-size: var(--font-size-section);
  }

  .article-title {
    font-size: var(--font-size-subheading);
  }

  /* Mobile responsive layout */
  @media (max-width: 768px) {
    .decade-groups {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .year-section {
      flex-direction: column;
      gap: 1rem;
    }

    .year-heading {
      width: auto;
      text-align: left;
    }

    .article-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .article-date {
      width: auto;
      align-self: flex-start;
    }
  }
</style>
