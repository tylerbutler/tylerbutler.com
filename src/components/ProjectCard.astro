---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BookOpen, ExternalLink } from "@lucide/astro";
import Github from "simple-icons-astro/Github";
import ProjectBadges from "./ProjectBadges.astro";

export interface Props {
  project: CollectionEntry<"projects">;
  /** Pre-rendered HTML from formatTitle(); consumed via set:html. */
  formattedTitle: string;
  /** h2 at top level, h3 inside a group section. */
  titleLevel?: 2 | 3;
  /** Group sections show one logo for the whole group, so members hide theirs. */
  showLogo?: boolean;
}

const {
  project,
  formattedTitle,
  titleLevel = 2,
  showLogo = true,
} = Astro.props;
const TitleTag = `h${titleLevel}` as "h2" | "h3";
---

<li class="project-item">
  <article>
    {showLogo && project.data.logo && (
      <Image
        src={project.data.logo}
        alt={`${project.data.title} logo`}
        class="project-logo"
        width={96}
      />
    )}
    <TitleTag set:html={formattedTitle} />
    <div class="article-badges">
      <ProjectBadges
        npm={project.data.npm}
        crate={project.data.crate}
        hex={project.data.hex}
        hexDocs={project.data.hexDocs}
        license={project.data.license}
        programmingLanguage={project.data.programmingLanguage}
        maturity={project.data.maturity}
      />
    </div>
    {project.data.description && (
      <p class="description">{project.data.description}</p>
    )}
    <div class="project-links">
      <a href={`/projects/${project.id}`} class="read-more" data-tinylytics-event="project.read-more" data-tinylytics-event-value={project.id}>
        <BookOpen class="icon" />
        Read More
      </a>
      {project.data.url && (
        <a href={project.data.url} target="_blank" rel="noopener" class="external-link" data-tinylytics-event="project.url" data-tinylytics-event-value={project.id}>
          <ExternalLink class="icon" />
          View Project
        </a>
      )}
      {project.data.github && (
        <a href={project.data.github} target="_blank" rel="noopener" class="external-link" data-tinylytics-event="project.github" data-tinylytics-event-value={project.id}>
          <Github class="icon" />
          GitHub
        </a>
      )}
    </div>
  </article>
</li>

<style>
  /* Cards are a layout list, not prose: drop the global li padding-left
     (0.5em, typography.css) so project titles sit flush with the section
     heading above them rather than 8px inside it. */
  .project-item {
    margin-bottom: 2.5em;
    padding-bottom: 2em;
    padding-left: 0;
    border-bottom: 1px solid var(--code-border);
  }

  .project-item:last-child {
    border-bottom: none;
  }

  /* Contains the floated logo: without a BFC, a card whose text is shorter
     than the 96px logo bleeds the float past its own bottom border. */
  .project-item article {
    display: flow-root;
  }

  .project-item h2,
  .project-item h3 {
    margin: 0 0 0.5em 0;
    color: var(--text);
  }

  .description {
    font-style: italic;
    color: var(--text-light);
    margin: 0.5em 0 1em 0;
    line-height: 1.5;
  }

  .project-links {
    margin-top: 1em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75em;
  }

  .project-links .icon {
    width: 16px;
    height: 16px;
  }

  /* Badges style themselves in ShieldsBadge.astro; scoped rules here never
     reached them anyway — those anchors carry ProjectBadges' scope id. */
  .article-badges {
    margin: 0.75em 0;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    font-size: var(--font-size-label);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Color states, not opacity — dimmed accent text drops below AA contrast */
  .project-links a:hover {
    text-decoration: none;
    color: var(--accent-hover);
  }

  /* "Read More" is the same action the homepage stream offers, so it wears the
     same control: the kudos/action-chip register from DESIGN.md §5, matching
     .read-more-link in index.astro. */
  .project-links .read-more {
    background: var(--code-bg);
    border: 1px solid var(--text-light);
    padding: 4px 10px;
    border-radius: var(--radius-md);
    font-style: italic;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text);
  }

  .project-links .read-more:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--light-bg);
  }

  /* Touch: grow to a ≥40px hit area by padding, not font size */
  @media (pointer: coarse) {
    .project-links {
      gap: 1.25em;
    }

    .project-links .read-more {
      padding: 12px 16px;
    }

    .external-link {
      padding: 10px 0;
    }
  }

  .project-logo {
    width: 96px;
    float: left;
    margin-right: 1em;
  }
</style>
