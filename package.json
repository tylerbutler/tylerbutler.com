{
  "name": "tylerbutler.com",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/tylerbutler/tylerbutler.com-hugo#readme",
  "bugs": {
    "url": "https://github.com/tylerbutler/tylerbutler.com-hugo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylerbutler/tylerbutler.com-hugo.git"
  },
  "license": "MIT",
  "author": "Tyler Butler <tyler@tylerbutler.com>",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "baseline": "npm run baseline:build && npm run baseline:lighthouse && npm run baseline:accessibility && npm run baseline:bundle",
    "baseline:accessibility": "npm run test:accessibility",
    "baseline:build": "npm run build",
    "baseline:bundle": "npm run test:bundle",
    "baseline:lighthouse": "npm run test:lighthouse && npm run test:lighthouse:mobile",
    "build": "astro build",
    "check": "astro check --minimumSeverity warning",
    "dev": "astro dev",
    "dev:drafts": "cross-env SHOW_DRAFTS=1 astro dev",
    "format": "biome check --write --linter-enabled=false",
    "linkcheck": "start-server-and-test dev http://localhost:4321 'cat complete-urls.txt | xargs lychee'",
    "prepare:og": "node scripts/prepare-og-assets.ts",
    "serve": "serve dist -l 4173",
    "test": "npm run test:visual && npm run test:performance && npm run test:accessibility && npm run test:bundle",
    "test:accessibility": "start-server-and-test serve http://localhost:4173 'pa11y-ci'",
    "test:bundle": "NODE_ENV=production npm run build && echo \"📊 Bundle analysis generated at dist/bundle-analysis.html\"",
    "test:headed": "playwright test --headed",
    "test:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "test:lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.cjs",
    "test:performance": "npm run test:lighthouse",
    "test:unit": "node --test 'netlify/**/*.test.mjs' 'scripts/*.test.ts'",
    "test:update": "playwright test --update-snapshots",
    "test:visual": "playwright test tests/visual"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/netlify": "^8.2.14",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@benjifs/github-store": "^0.2.0",
    "@benjifs/micropub": "^2.0.1",
    "@expressive-code/plugin-line-numbers": "^0.44.4",
    "@floating-ui/dom": "^1.8.0",
    "@iconify-json/iconoir": "^1.2.12",
    "@lottiefiles/dotlottie-web": "^0.83.2",
    "@lucide/astro": "^1.80.0",
    "@netlify/api": "^14.0.19",
    "astro": "^7.4.13",
    "astro-broken-links-checker": "github:imazen/astro-broken-link-checker",
    "astro-embed": "^0.14.0",
    "astro-expressive-code": "^0.44.4",
    "astro-icon": "^1.2.0",
    "astro-toc": "^0.2.0",
    "badge-maker": "^5.0.2",
    "expressive-code-twoslash": "^0.6.1",
    "littlefoot": "^4.1.4",
    "pathe": "^2.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-expressive-code": "^0.44.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.1",
    "remark-mermaid": "^0.2.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-shift-headings": "^1.0.0",
    "remark-smartypants": "^3.0.3",
    "remark-stringify": "^11.0.0",
    "sanitize-html": "2.17.2",
    "simple-icons-astro": "^16.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@dotlottie/dotlottie-js": "^1.10.0",
    "@fontsource/lato": "^5.3.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/hast": "^3.0.5",
    "@types/subset-font": "^2.3.0",
    "cross-env": "^10.1.0",
    "pa11y-ci": "^4.1.1",
    "pagefind": "^1.6.0",
    "postcss-nesting": "^14.0.3",
    "rehype-footnotes": "^1.0.0",
    "remark-lazy-links": "^1.0.0",
    "rollup-plugin-visualizer": "^7.3.0",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "simple-icons": "^16.38.1",
    "start-server-and-test": "^3.0.13",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.23.0"
}
