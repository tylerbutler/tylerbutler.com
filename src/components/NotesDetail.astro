---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { NoteCounts } from "../lib/note-counts";
import type { Note } from "../lib/note-schema";
import { getNoteUrl } from "../lib/note-utils";
import { renderNote } from "../lib/render-note";
import NoteCard from "./NoteCard.astro";

interface Props {
  note: Note;
  counts: NoteCounts;
}
const { note, counts } = Astro.props;
const html = await renderNote(note);

const formattedDate = note.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const canonicalUrl = `https://tylerbutler.com${getNoteUrl(note)}`;
const pageTitle = note.data.title
  ? `${note.data.title} - Tyler Butler`
  : `${formattedDate} - Tyler Butler`;
---

<BaseLayout
  title={pageTitle}
  description={note.data.summary}
  headerSize="small"
  canonicalUrl={canonicalUrl}
>
  <NoteCard note={note} counts={counts} variant="detail" titleLevel={1}>
    <Fragment set:html={html} />
  </NoteCard>

  <footer class="note-footer">
    <a href="/notes/" class="back-link">← All notes</a>
  </footer>
</BaseLayout>

<style>
  .note-footer {
    max-width: 65ch;
    margin: 2rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border, #ddd);
  }

  .back-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 14px;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
