---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { NoteCounts } from "../lib/note-counts";
import type { Note } from "../lib/note-schema";
import { renderNote } from "../lib/render-note";
import NoteCard from "./NoteCard.astro";
import "../lib/styles/page-nav.css";
import {
  getNoteMonthUrl,
  getNotePathParts,
  getNoteYearUrl,
  monthLabel,
} from "../lib/note-utils";

interface Props {
  notes: Note[];
  counts: NoteCounts;
  year: string;
  month: string;
}
const { notes, counts, year, month } = Astro.props;
const allItems = notes.map((note) => ({ note, ...getNotePathParts(note) }));
const keys = [
  ...new Set(allItems.map((item) => `${item.year}-${item.month}`)),
].sort();
const index = keys.indexOf(`${year}-${month}`);
const parts = (key?: string) =>
  key ? { year: key.slice(0, 4), month: key.slice(5) } : null;
const prev = parts(keys[index - 1]);
const next = parts(keys[index + 1]);
const items = allItems.filter(
  (item) => item.year === year && item.month === month,
);

const heading = `${monthLabel(month)} ${year}`;

const renderedItems = await Promise.all(
  items.map(async (item) => {
    return { ...item, html: await renderNote(item.note) };
  }),
);
---

<BaseLayout
  title={`Notes from ${heading} - Tyler Butler`}
  description={`Short-form notes from ${heading}.`}
  excludeFromSearch
>
  <section class="notes-page h-feed">
    <nav class="archive-crumbs">
      <a href="/notes/">Notes</a> /{" "}
      <a href={getNoteYearUrl(year)}>{year}</a> /{" "}
      <span>{monthLabel(month)}</span>
    </nav>
    <h1>{heading}</h1>
    <p class="archive-count">
      {items.length} note{items.length === 1 ? "" : "s"}
    </p>

    <div class="notes-stream">
      {
        renderedItems.map(({ note, html }) => (
          <NoteCard note={note} counts={counts} titleLevel={2}>
            <Fragment set:html={html} />
          </NoteCard>
        ))
      }
    </div>

    <nav class="article-nav">
      {
        prev && (
          <a
            href={getNoteMonthUrl(prev.year, prev.month)}
            class="nav-link"
          >
            <span class="nav-arrow" aria-hidden="true">←</span>
            <span class="nav-text">
              {monthLabel(prev.month)} {prev.year}
            </span>
          </a>
        )
      }
      {
        next && (
          <a
            href={getNoteMonthUrl(next.year, next.month)}
            class="nav-link nav-link-next"
          >
            <span class="nav-text">
              {monthLabel(next.month)} {next.year}
            </span>
            <span class="nav-arrow" aria-hidden="true">→</span>
          </a>
        )
      }
    </nav>
  </section>
</BaseLayout>

<style>
  .notes-page {
    max-width: 65ch;
    margin: 0 auto;
  }

  .archive-crumbs {
    font-size: 14px;
    color: var(--text-light);
    margin-bottom: 0.5rem;
  }

  .archive-crumbs a {
    color: var(--text-light);
    text-decoration: none;
  }

  .archive-crumbs a:hover {
    color: var(--accent);
  }

  .archive-count {
    color: var(--text-light);
    font-size: 14px;
    margin-top: 0.5rem;
  }

  .notes-stream {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
