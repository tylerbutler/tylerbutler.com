---
import { getCollection } from "astro:content";
import ActionChip from "../components/ActionChip.astro";
import ConstellationIcon from "../components/ConstellationIcon.astro";
import KudosButton from "../components/KudosButton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getArticleDisplayTitle,
  getArticleSlug,
  getArticleUrl,
} from "../lib/article-utils";
import { includeDraft } from "../lib/draft-utils";
import { createHomepagePreview } from "../lib/markdown-utils";
import { formatTitle } from "../lib/typography";

// Constellation lottie files — Vite resolves these to hashed URLs at build time.
// Only constellation files are imported; other/ files are not bundled unless used.
const constellationModules = import.meta.glob<string>(
  "../lottie/constellations/*.lottie",
  { query: "?url", import: "default", eager: true },
);

// name → URL map (e.g. "aquarius" → "/assets/aquarius.B9uJRUL3.lottie")
const constellationUrls: Record<string, string> = Object.fromEntries(
  Object.entries(constellationModules).map(([path, url]) => [
    path.split("/").pop()!.replace(".lottie", ""),
    url,
  ]),
);

function hashStr(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
  return Math.abs(h);
}

const CONSTELLATION_NAMES = Object.keys(constellationUrls);

// Assign icons with no duplicates. Each article is processed in hash order
// so its slot is determined independently of display order — adding a new
// article only displaces others if it lands in an already-taken slot.
function assignIcons(
  ids: string[],
): Map<string, { url: string; slug: string }> {
  const result = new Map<string, { url: string; slug: string }>();
  const used = new Set<number>();
  for (const id of [...ids].sort((a, b) => hashStr(a) - hashStr(b))) {
    let idx = hashStr(id) % CONSTELLATION_NAMES.length;
    while (used.has(idx)) idx = (idx + 1) % CONSTELLATION_NAMES.length;
    used.add(idx);
    const slug = CONSTELLATION_NAMES[idx];
    result.set(id, { url: constellationUrls[slug], slug });
  }
  return result;
}

// Get recent articles (latest 5; drafts hidden unless SHOW_DRAFTS=1)
const articles = await getCollection("articles", ({ data }) =>
  includeDraft(data),
);

// Sort by date (newest first) and take first 5
const sortedArticles = articles
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 5);

// Render articles with full markdown pipeline and h3 headings for homepage
const recentArticles = await Promise.all(
  sortedArticles.map(async (article) => {
    const { html, isTruncated } = await createHomepagePreview(
      article.body ?? "",
    );

    return {
      ...article,
      transformedHtml: html,
      isTruncated,
      formattedTitle: await formatTitle(getArticleDisplayTitle(article)),
      previewId: `article-${getArticleSlug(article)}`,
    };
  }),
);

const iconAssignments = assignIcons(recentArticles.slice(1).map((a) => a.id));
---

<BaseLayout
  title="Tyler Butler - Personal Website"
  description="Personal website and blog of Tyler Butler, featuring articles on technology, programming, and more."
  headerSize="large"
  containerClass="site-container--homepage"
  excludeFromSearch
>
  <div class="homepage-layout">
    {recentArticles.length > 0 && (
      <nav class="current-issue" aria-labelledby="current-issue-heading">
        <div class="current-issue-heading">
          <h2 id="current-issue-heading" data-rail-heading>Latest Articles</h2>
          <div
            class="rail-mode-switch"
            role="group"
            aria-label="Article navigation view"
            hidden
          >
            <button
              type="button"
              data-rail-mode="issue"
              aria-controls="current-issue-list"
              aria-pressed="true"
            >
              Articles
            </button>
            <button
              type="button"
              data-rail-mode="sections"
              aria-controls="current-issue-list"
              aria-pressed="false"
            >
              Sections
            </button>
          </div>
        </div>
        <ol id="current-issue-list">
          {recentArticles.map((article, index) => (
            <li
              data-issue-target={article.previewId}
              data-issue-number={String(index + 1).padStart(2, "0")}
            >
              <a
                class="issue-article-link"
                href={`#${article.previewId}`}
                set:html={article.formattedTitle}
              />
              <ul class="issue-sections" hidden></ul>
            </li>
          ))}
        </ol>
        <p class="current-issue-archive">
          <a href="/articles/">Browse All {articles.length} Articles →</a>
        </p>
      </nav>
    )}

    {recentArticles.length > 1 && (
      <details class="mobile-stream-nav">
        <summary>
          <span class="mobile-stream-position" data-mobile-stream-position>
            01/{String(recentArticles.length).padStart(2, "0")}
          </span>
          <span class="mobile-stream-title" data-mobile-stream-title>
            <span set:html={recentArticles[0].formattedTitle} />
          </span>
        </summary>
        <ol>
          {recentArticles.map((article, index) => (
            <li>
              <a href={`#${article.previewId}`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span set:html={article.formattedTitle} />
              </a>
            </li>
          ))}
        </ol>
      </details>
    )}

    <div class="main-content">
      {recentArticles.length > 0 && (
        <ul class="recent-articles">
          {recentArticles.map((article, index) => {
            const date = new Date(article.data.date);

            return (
              <>
                {index > 0 && (() => {
                  const { url, slug } = iconAssignments.get(article.id)!;
                  return (
                    <li class="article-divider" role="presentation" aria-hidden="true">
                      <ConstellationIcon src={url} slug={slug} size={64} />
                    </li>
                  );
                })()}
                <li>
                  <article class="article-preview" data-article-preview={article.previewId}>
                    <h2 id={article.previewId}>
                      <a
                        class="stream-title-link"
                        href={getArticleUrl(article)}
                        set:html={article.formattedTitle}
                      />
                    </h2>
                    <div class="article-meta">
                      <time datetime={article.data.date.toISOString()}>
                        {date.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric'
                        })}
                      </time>
                    </div>
                    <div class="article-content" set:html={article.transformedHtml}></div>
                    <p class="preview-actions">
                      {article.isTruncated ? (
                        <ActionChip href={getArticleUrl(article)}>Read More →</ActionChip>
                      ) : (
                        <ActionChip href={getArticleUrl(article)}>Permalink →</ActionChip>
                      )}
                      <KudosButton path={getArticleUrl(article)} variant="preview" />
                    </p>
                  </article>
                </li>
              </>
            );
          })}
        </ul>
      )}

      <nav class="stream-footer" aria-label="Keep reading">
        <ActionChip href="/articles/">Browse the Archive →</ActionChip>
        <ActionChip href="/subscribe">Subscribe</ActionChip>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .homepage-layout {
    margin: 0;
  }

  .recent-articles {
    list-style: none;
    padding: 0;
    margin: 2em 0;
  }

  .current-issue {
    margin: 0 0 4em;
    padding: 1.25em 1.5em;
    background: var(--code-bg);
    border-radius: var(--radius-md);
  }

  .current-issue-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
    padding-bottom: 0.75em;
    border-bottom: 1px solid var(--code-border);
  }

  .current-issue-heading h2 {
    font-family: "Lato", "Helvetica Neue", Arial, sans-serif;
    font-size: var(--font-size-ui);
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .mobile-stream-nav {
    display: none;
  }

  .rail-mode-switch {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25em;
    width: 100%;
  }

  .rail-mode-switch[hidden] {
    display: none;
  }

  .rail-mode-switch button {
    padding: 0.45em 0;
    border: 0;
    border-bottom: 1px solid var(--code-border);
    color: var(--text-light);
    background: transparent;
    font-family: "Lato", "Helvetica Neue", Arial, sans-serif;
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
  }

  .rail-mode-switch button:hover,
  .rail-mode-switch button[aria-pressed="true"] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .rail-mode-switch button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .rail-mode-switch button:disabled {
    color: var(--text-light);
    border-bottom-color: var(--code-border);
    cursor: not-allowed;
    opacity: 0.55;
  }

  .current-issue ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5em 2em;
    margin: 1em 0 0;
    padding-left: 1.75em;
  }

  .current-issue[data-mode="sections"] ol {
    display: block;
    padding-left: 0;
    list-style: none;
  }

  .current-issue[data-mode="sections"] ol > li:not(.is-active),
  .current-issue[data-mode="sections"] .issue-article-link {
    display: none;
  }

  .current-issue li {
    margin: 0;
    padding-left: 0.25em;
    color: var(--text-light);
    font-variant-numeric: tabular-nums;
  }

  .current-issue li::marker {
    font-family: "Lato", "Helvetica Neue", Arial, sans-serif;
    font-size: var(--font-size-meta);
  }

  .current-issue li a {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  .issue-article-link {
    text-decoration: none;
  }

  .issue-article-link:hover {
    color: var(--accent);
  }

  .issue-article-link[aria-current="location"] {
    color: var(--accent);
    font-weight: 600;
  }

  .issue-sections {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    margin: 0.45em 0 0.15em;
    padding-left: 1em;
    list-style: disc;
  }

  .issue-sections[hidden] {
    display: none;
  }

  .issue-sections :global(li) {
    padding-left: 0;
    font-size: var(--font-size-meta);
  }

  .issue-sections :global(a) {
    color: var(--text-light);
    line-height: 1.35;
    text-decoration: none;
  }

  .issue-sections :global(a:hover) {
    color: var(--accent);
  }

  .current-issue-archive {
    margin: 1em 0 0;
    padding-top: 0.75em;
    border-top: 1px solid var(--code-border);
    font-size: var(--font-size-label);
  }

  .article-preview {
    margin-bottom: 1.5em;
    padding-bottom: 1em;
  }

  .article-divider {
    display: flex;
    justify-content: center;
    margin: 1em 0 4em;
    list-style: none;
  }


  /* Size, face, and weight inherit from the global h2 ramp (typography.css) */
  .article-preview h2 {
    margin: 0 0 0.5em 0;
    scroll-margin-block-start: 1rem;
  }

  /* Stream titles read as headings first; color provides the link state. */
  .stream-title-link {
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .stream-title-link:hover {
    color: var(--accent);
  }

  .article-preview h2:target .stream-title-link {
    color: var(--accent);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1em;
    margin-bottom: 0.5em;
  }

  .article-preview time {
    font-size: var(--font-size-meta);
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 1px;
    flex-shrink: 0;
  }

  /* Injected article HTML (set:html) is unscoped, so its typography comes
     from the global stylesheets — only the wrapper itself is styled here */
  .article-content {
    margin: 0.5em 0;
    min-width: 0;
    max-width: 100%;
  }

  .article-content > :global(p),
  .article-content > :global(ul),
  .article-content > :global(ol),
  .article-content > :global(dl),
  .article-content > :global(blockquote) {
    max-width: 70ch;
  }

  .preview-actions {
    margin: 1em 0 0 0;
    display: flex;
    align-items: center;
    gap: 0.75em;
  }

  /* The stream chip itself lives in ActionChip.astro; only the kudos button
     beside it needs local sizing to sit level with it. */
  .preview-actions :global(.tinylytics_kudos) {
    font-size: var(--font-size-label);
    padding: 2px 8px;
  }

  /* Touch: grow the kudos button to a comfortable thumb target (the chip
     grows itself) and widen the gap between them */
  @media (pointer: coarse) {
    .preview-actions {
      gap: 1.25em;
    }

    .preview-actions :global(.tinylytics_kudos) {
      padding: 10px 14px;
    }
  }

  @media (max-width: 600px) {
    .current-issue {
      display: block;
      margin-bottom: 1.25em;
      padding: 0.5em 0;
      background: transparent;
    }

    .current-issue-heading {
      display: block;
      padding: 0 0 0.5em;
      border: 0;
    }

    .current-issue-heading h2 {
      font-size: var(--font-size-meta);
      line-height: 1.3;
    }

    .current-issue ol {
      display: flex;
      gap: 0.5em;
      margin: 0;
      padding: 0.25em 0;
      width: 100%;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline proximity;
      scrollbar-color: var(--accent) transparent;
      counter-reset: issue;
    }

    .current-issue ol > li:first-child {
      display: none;
    }

    .current-issue ol > li {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
      gap: 0.5em;
      flex: 0 0 calc(100% - 32px);
      margin: 0;
      padding: 0.45em 0.6em;
      background: var(--light-bg);
      border: 1px solid var(--code-border);
      border-radius: var(--radius-md);
      scroll-snap-align: start;
    }

    .current-issue ol > li::before {
      content: attr(data-issue-number);
      color: var(--text-light);
      font-family: "Lato", "Helvetica Neue", Arial, sans-serif;
      font-size: var(--font-size-meta);
      font-variant-numeric: tabular-nums;
    }

    .current-issue-archive {
      display: none;
    }

    .mobile-stream-nav.is-visible {
      position: fixed;
      z-index: 90;
      top: max(8px, env(safe-area-inset-top));
      left: 5vw;
      right: 5vw;
      display: block;
      color: var(--nav-links);
      background: var(--dark-bg);
      border: 1px solid
        color-mix(in srgb, var(--header-accent) 55%, transparent);
      border-radius: var(--radius-md);
      box-shadow: 0 4px 12px var(--overlay);
    }

    .mobile-stream-nav summary {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0.75em;
      min-height: 44px;
      padding: 0 0.75em;
      cursor: pointer;
      list-style: none;
    }

    .mobile-stream-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-stream-nav summary::after {
      content: "+";
      grid-column: 3;
      color: var(--header-accent);
      font-family: "Lato", "Helvetica Neue", Arial, sans-serif;
    }

    .mobile-stream-nav[open] summary::after {
      content: "−";
    }

    .mobile-stream-position {
      color: var(--header-accent);
      font-family: "Lato", "Helvetica Neue", Arial, sans-serif;
      font-size: var(--font-size-meta);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.08em;
    }

    .mobile-stream-title {
      overflow: hidden;
      font-size: var(--font-size-label);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mobile-stream-nav ol {
      max-height: min(60vh, 24rem);
      margin: 0;
      padding: 0.5em 0.75em 0.75em;
      overflow-y: auto;
      border-top: 1px solid
        color-mix(in srgb, var(--header-accent) 30%, transparent);
      list-style: none;
    }

    .mobile-stream-nav li {
      margin: 0;
    }

    .mobile-stream-nav a {
      display: grid;
      grid-template-columns: 2em minmax(0, 1fr);
      gap: 0.75em;
      padding: 0.65em 0;
      color: var(--nav-links);
      text-decoration: none;
    }

    .mobile-stream-nav a span:first-child {
      color: var(--header-accent);
      font-family: "Lato", "Helvetica Neue", Arial, sans-serif;
      font-size: var(--font-size-meta);
      font-variant-numeric: tabular-nums;
    }

    .mobile-stream-nav a:hover,
    .mobile-stream-nav a:focus-visible {
      color: var(--nav-hover);
    }
  }

  @media (min-width: 1200px) {
    :global(.site-container--homepage) {
      width: var(--container-width);
      margin-left: calc((100vw - var(--container-width) - 100px) / 2);
      margin-right: auto;
    }

    .homepage-layout {
      display: grid;
      grid-template-areas: "main issue";
      grid-template-columns: minmax(0, 1fr) 250px;
      column-gap: 35px;
      width: calc(100% + 285px);
    }

    .main-content {
      grid-area: main;
      min-width: 0;
    }

    .current-issue {
      grid-area: issue;
      align-self: start;
      position: sticky;
      top: 2em;
      margin: 0;
      padding: 1.5em;
      max-height: calc(100vh - 4em);
      overflow-y: auto;
      background: var(--light-bg);
      border-top: 1px solid var(--accent);
      border-radius: 0;
    }

    .current-issue-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5em;
    }

    .current-issue ol {
      grid-template-columns: 1fr;
      gap: 0.65em;
      padding-left: 1.5em;
    }
  }

  /* End-of-stream: the archive is the way onward */
  .stream-footer {
    margin: 3em 0 1em;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75em;
  }
</style>

<script>
  const railQuery = window.matchMedia("(min-width: 1200px)");
  const issueNav = document.querySelector<HTMLElement>(".current-issue");
  const railHeading =
    document.querySelector<HTMLElement>("[data-rail-heading]");
  const railModeSwitch =
    document.querySelector<HTMLElement>(".rail-mode-switch");
  const mobileStreamNav =
    document.querySelector<HTMLDetailsElement>(".mobile-stream-nav");
  const mobileStreamPosition = document.querySelector<HTMLElement>(
    "[data-mobile-stream-position]",
  );
  const mobileStreamTitle = document.querySelector<HTMLElement>(
    "[data-mobile-stream-title]",
  );
  const streamFooter = document.querySelector<HTMLElement>(".stream-footer");
  const railModeButtons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-rail-mode]"),
  ];
  const previews = [
    ...document.querySelectorAll<HTMLElement>("[data-article-preview]"),
  ];
  const issueItems = new Map(
    [...document.querySelectorAll<HTMLElement>("[data-issue-target]")].map(
      (item) => [item.dataset.issueTarget, item],
    ),
  );

  for (const preview of previews) {
    const previewId = preview.dataset.articlePreview;
    const issueItem = issueItems.get(previewId);
    const sectionList =
      issueItem?.querySelector<HTMLUListElement>(".issue-sections");
    if (!previewId || !sectionList) continue;

    const headings = preview.querySelectorAll<HTMLElement>(
      ".article-content h3, .article-content h4, .article-content h5",
    );

    headings.forEach((heading, index) => {
      const originalId = heading.id || `section-${index + 1}`;
      const headingId = `${previewId}-${originalId}`;
      heading.id = headingId;
      for (const link of preview.querySelectorAll<HTMLAnchorElement>("a[href]")) {
        if (link.getAttribute("href") === `#${originalId}`) {
          link.setAttribute("href", `#${headingId}`);
        }
      }

      const item = document.createElement("li");
      const link = document.createElement("a");
      link.href = `#${headingId}`;
      link.textContent = heading.textContent?.trim() || `Section ${index + 1}`;
      item.append(link);
      sectionList.append(item);
    });
  }

  type RailMode = "issue" | "sections";

  let activePreviewId: string | undefined;
  let railMode: RailMode = "issue";

  function setActiveIssue(
    previewId?: string,
    requestedMode: RailMode = railMode,
  ) {
    const activeItem = previewId ? issueItems.get(previewId) : undefined;
    const activeSections =
      activeItem?.querySelector<HTMLUListElement>(".issue-sections");
    const canShowSections = Boolean(activeSections?.children.length);
    const mode =
      requestedMode === "sections" && canShowSections ? "sections" : "issue";

    if (issueNav) issueNav.dataset.mode = mode;
    if (railModeSwitch) {
      railModeSwitch.hidden = !railQuery.matches || !canShowSections;
    }
    if (railHeading) {
      const articleTitle =
        activeItem
          ?.querySelector<HTMLAnchorElement>(".issue-article-link")
          ?.textContent?.trim() ?? "";
      railHeading.textContent =
        mode === "sections" && articleTitle
          ? `Contents · ${articleTitle}`
          : "Latest Articles";
    }
    for (const button of railModeButtons) {
      const buttonMode = button.dataset.railMode as RailMode;
      button.setAttribute("aria-pressed", String(buttonMode === mode));
      button.disabled = buttonMode === "sections" && !canShowSections;
    }

    for (const [id, item] of issueItems) {
      const isActive = railQuery.matches && id === previewId;
      const articleLink =
        item.querySelector<HTMLAnchorElement>(".issue-article-link");
      const sectionList =
        item.querySelector<HTMLUListElement>(".issue-sections");

      item.classList.toggle("is-active", isActive);
      articleLink?.toggleAttribute("aria-current", isActive);
      if (articleLink && isActive) {
        articleLink.setAttribute("aria-current", "location");
      }
      if (sectionList) {
        sectionList.hidden =
          mode !== "sections" ||
          !isActive ||
          sectionList.children.length === 0;
      }
    }
  }

  function updateActiveIssue() {
    if (previews.length === 0) {
      activePreviewId = undefined;
      railMode = "issue";
      setActiveIssue(undefined, railMode);
      return;
    }

    const activationLine = window.innerHeight * 0.3;
    let activePreview = previews[0];

    for (const preview of previews) {
      if (preview.getBoundingClientRect().top > activationLine) break;
      activePreview = preview;
    }

    const nextPreviewId = activePreview.dataset.articlePreview;
    activePreviewId = nextPreviewId;

    const activeIndex = previews.indexOf(activePreview);
    const activeItem = activePreviewId
      ? issueItems.get(activePreviewId)
      : undefined;
    const activeTitle =
      activeItem
        ?.querySelector<HTMLAnchorElement>(".issue-article-link")
        ?.textContent?.trim() ?? "";
    if (mobileStreamPosition) {
      mobileStreamPosition.textContent = `${String(activeIndex + 1).padStart(
        2,
        "0",
      )}/${String(previews.length).padStart(2, "0")}`;
    }
    if (mobileStreamTitle) mobileStreamTitle.textContent = activeTitle;

    const issueIsPast = (issueNav?.getBoundingClientRect().bottom ?? 0) < 0;
    const footerIsNear =
      (streamFooter?.getBoundingClientRect().top ?? window.innerHeight) <
      window.innerHeight * 0.85;
    mobileStreamNav?.classList.toggle(
      "is-visible",
      !railQuery.matches && issueIsPast && !footerIsNear,
    );

    if (!railQuery.matches) {
      railMode = "issue";
      setActiveIssue(undefined, railMode);
      return;
    }

    setActiveIssue(activePreviewId, railMode);
  }

  let updateFrame = 0;
  function scheduleActiveIssueUpdate() {
    if (updateFrame) return;
    updateFrame = window.requestAnimationFrame(() => {
      updateFrame = 0;
      updateActiveIssue();
    });
  }

  window.addEventListener("scroll", scheduleActiveIssueUpdate, {
    passive: true,
  });
  window.addEventListener("resize", scheduleActiveIssueUpdate);
  railQuery.addEventListener("change", () => {
    railMode = "issue";
    updateActiveIssue();
  });
  for (const button of railModeButtons) {
    button.addEventListener("click", () => {
      railMode = button.dataset.railMode as RailMode;
      setActiveIssue(activePreviewId, railMode);
    });
  }
  for (const link of mobileStreamNav?.querySelectorAll("a") ?? []) {
    link.addEventListener("click", () => {
      if (mobileStreamNav) mobileStreamNav.open = false;
    });
  }
  updateActiveIssue();
</script>
