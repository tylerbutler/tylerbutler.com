---
import headlinesRaw from "../data/headlines.txt?raw";
import Navigation from "./Navigation.astro";
import SearchButton from "./SearchButton.astro";
import SocialIconsBelow from "./SocialIconsBelow.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  size?: "large" | "small";
}

const { size = "large" } = Astro.props;

const headlines = headlinesRaw.split("\n").filter((line) => line.trim() !== "");
---

<header
  class:list={["site-header", `site-header--${size}`]}
  data-pagefind-ignore="all"
  data-headlines={size === "large" ? JSON.stringify(headlines) : undefined}
>
  <div class="header-controls">
    <SearchButton/>
    <ThemeToggle/>
  </div>

  {size === "large" ? (
    <h1>
      <a href="/">Tyler Butler</a>
    </h1>
  ) : (
    <div class="site-title">
      <a href="/">Tyler Butler</a>
    </div>
  )}

  {size === "large" && <p class="tagline" id="random-headline"></p>}
  <Navigation/>
  <SocialIconsBelow compact={size === "small"}/>
</header>

<script>
  const largeHeader = document.querySelector<HTMLElement>(
    ".site-header--large[data-headlines]",
  );
  const headlines = JSON.parse(largeHeader?.dataset.headlines ?? "[]") as string[];
  const taglineElement = document.getElementById("random-headline");
  if (taglineElement && headlines.length > 0) {
    let currentIndex = Math.floor(Math.random() * headlines.length);
    taglineElement.textContent = headlines[currentIndex] + "\u00A0";

    // Rotate headline every 60 seconds with crossfade
    setInterval(() => {
      // Pick a different headline
      let newIndex;
      do {
        newIndex = Math.floor(Math.random() * headlines.length);
      } while (newIndex === currentIndex && headlines.length > 1);
      currentIndex = newIndex;

      // Fade out
      taglineElement.classList.add("fading");

      // After fade out, change text and fade in
      setTimeout(() => {
        taglineElement.textContent = headlines[currentIndex] + "\u00A0";
        taglineElement.classList.remove("fading");
      }, 300);
    }, 60000);
  }
</script>

<style>
  .site-header {
    position: relative;
    padding-top: 25px !important;
    padding-bottom: 20px !important;
  }

  .site-header--small {
    padding: 18px 56px 14px !important;
  }

  .header-controls {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 10;
    display: flex;
    gap: 4px;
    align-items: center;
  }

  /* Touch: the buttons grow to 40px hit areas (their own coarse-pointer
     padding), so anchor the group to the corner — the visible icons stay
     in place and the padded boxes don't reach into the nav row below */
  @media (pointer: coarse) {
    .header-controls {
      top: 0;
      right: 0;
      gap: 0;
    }
  }

  .site-header h1 {
    margin-top: 0px !important;
    margin-bottom: 3px !important;
  }

  .site-header--small .site-title {
    margin: 0 0 2px;
  }

  /* Headline rotation crossfade */
  .tagline {
    transition: opacity 0.3s ease;
  }

  .tagline.fading {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .tagline {
      transition: none;
    }
  }

  @media (max-width: 480px) {
    .site-header--small {
      padding: 16px 16px 12px !important;
    }
  }

  /* Screen reader only text */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
