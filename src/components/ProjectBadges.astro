---
import { languageBadge } from "../lib/badges";
import ShieldsBadge from "./ShieldsBadge.astro";

type Maturity = "stable" | "unpublished" | "experimental";

interface Props {
  npm?: string;
  crate?: string;
  hex?: string;
  hexDocs?: string;
  license?: string;
  programmingLanguage?: string;
  maturity?: Maturity;
}

const { npm, crate, hex, hexDocs, license, programmingLanguage, maturity } =
  Astro.props;

const maturityConfig: Record<Maturity, { message: string; color: string }> = {
  stable: { message: "stable", color: "brightgreen" },
  experimental: { message: "experimental", color: "orange" },
  unpublished: { message: "unpublished", color: "lightgrey" },
};

const language = programmingLanguage
  ? languageBadge(programmingLanguage)
  : undefined;

// Version badges are served by shields.io rather than rendered at build, so a
// release shows up without waiting for a redeploy. Height is fixed at the
// shields "flat" height to keep the row from shifting vertically as they load.
---

{maturity && (
  <ShieldsBadge label="status" message={maturityConfig[maturity].message} color={maturityConfig[maturity].color} />
)}
{npm && (
  <a href={`https://www.npmjs.com/package/${npm}`} class="badge" target="_blank" rel="noopener">
    <img src={`https://img.shields.io/npm/v/${npm}`} alt={`${npm} npm version`} height="20" loading="lazy" />
  </a>
)}
{programmingLanguage && language && (
  <ShieldsBadge
    label="written in"
    message={programmingLanguage}
    color={language.color}
    logoBase64={language.logoBase64}
  />
)}
{crate && (
  <a href={`https://crates.io/crates/${crate}`} class="badge" target="_blank" rel="noopener">
    <img src={`https://img.shields.io/crates/v/${crate}`} alt={`${crate} crate version`} height="20" loading="lazy" />
  </a>
)}
{hex && (
  <a href={`https://hex.pm/packages/${hex}`} class="badge" target="_blank" rel="noopener">
    <img src={`https://img.shields.io/hexpm/v/${hex}`} alt={`${hex} hex version`} height="20" loading="lazy" />
  </a>
)}
{hexDocs && (
  <a href={`https://hexdocs.pm/${hexDocs}`} class="badge" target="_blank" rel="noopener">
    <ShieldsBadge label="hex" message="docs" color="ffaff3" />
  </a>
)}
{license && (
  <a href={`https://opensource.org/licenses/${license}`} class="badge" target="_blank" rel="noopener">
    <ShieldsBadge label="license" message={license} color="blue" />
  </a>
)}

<style>
  img {
    margin-right: 0.5em;
    vertical-align: top;
  }
</style>
