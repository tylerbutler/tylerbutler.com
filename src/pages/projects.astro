---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import ConstellationIcon from "../components/ConstellationIcon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { includeDraft } from "../lib/draft-utils";
import { formatTitle } from "../lib/typography";

// Constellation lottie files — Vite resolves these to hashed URLs at build time.
const constellationModules = import.meta.glob<string>(
  "../lottie/constellations/*.lottie",
  { query: "?url", import: "default", eager: true },
);

const constellationUrls: Record<string, string> = Object.fromEntries(
  Object.entries(constellationModules).map(([path, url]) => [
    path.split("/").pop()!.replace(".lottie", ""),
    url,
  ]),
);

function hashStr(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
  return Math.abs(h);
}

const CONSTELLATION_NAMES = Object.keys(constellationUrls);

// Same assignment the homepage stream uses: hash order, no duplicates on screen.
function assignIcons(
  ids: string[],
): Map<string, { url: string; slug: string }> {
  const result = new Map<string, { url: string; slug: string }>();
  const used = new Set<number>();
  for (const id of [...ids].sort((a, b) => hashStr(a) - hashStr(b))) {
    let idx = hashStr(id) % CONSTELLATION_NAMES.length;
    while (used.has(idx)) idx = (idx + 1) % CONSTELLATION_NAMES.length;
    used.add(idx);
    const slug = CONSTELLATION_NAMES[idx];
    result.set(id, { url: constellationUrls[slug], slug });
  }
  return result;
}

// Get all projects (excluding index files; drafts hidden unless SHOW_DRAFTS=1)
const projects = await getCollection(
  "projects",
  ({ id, data }) => !id.startsWith("_") && includeDraft(data),
);

// `date` is optional in the schema, so undated projects sort last rather than
// being filtered out — dropping a project silently is worse than showing it
// at the end of its section.
const timeOf = (value: Date | undefined): number =>
  value ? new Date(value).getTime() : Number.NEGATIVE_INFINITY;

const withTitles = await Promise.all(
  [...projects]
    .sort((a, b) => timeOf(b.data.date) - timeOf(a.data.date))
    .map(async (project) => ({
      ...project,
      formattedTitle: await formatTitle(project.data.title),
    })),
);

// Bucket by referenced group id. A reference resolves to { collection, id },
// not the entry, so we match ids against the group collection loaded below
// rather than paying a getEntry() per project.
const byGroup = new Map<string, typeof withTitles>();
for (const project of withTitles) {
  const id = project.data.group?.id;
  if (!id) continue;
  const bucket = byGroup.get(id);
  if (bucket) bucket.push(project);
  else byGroup.set(id, [project]);
}

const allGroups = await getCollection(
  "projectGroups",
  ({ id }) => !id.startsWith("_"),
);

// Groups sort by their newest member's date (matching the newest-first order
// of the project cards themselves), falling back to `order` and then id when
// a group has no dated members to compare.
const newestDateOf = (groupId: string): number =>
  (byGroup.get(groupId) ?? []).reduce(
    (max, project) => Math.max(max, timeOf(project.data.date)),
    Number.NEGATIVE_INFINITY,
  );

// Astro only validates a reference() when it is resolved via getEntry(), which
// we intentionally skip — so a typo'd `group:` would otherwise silently drop a
// project into the ungrouped list. Check against every group, drafts included,
// so that referencing a draft group stays legal.
const knownGroupIds = new Set(allGroups.map((group) => group.id));
const badReferences = withTitles
  .filter((p) => p.data.group && !knownGroupIds.has(p.data.group.id))
  .map((p) => `${p.id} → "${p.data.group?.id}"`);
if (badReferences.length > 0) {
  throw new Error(
    `Unknown project group referenced by ${badReferences.length} project(s): ${badReferences.join(", ")}. ` +
      `Known groups: ${[...knownGroupIds].join(", ")}.`,
  );
}

const groupEntries = allGroups.filter(({ data }) => includeDraft(data));

// render() is async and can't be awaited inside JSX, so section bodies are
// rendered up front.
const groups = (
  await Promise.all(
    groupEntries
      .sort(
        (a, b) =>
          newestDateOf(b.id) - newestDateOf(a.id) ||
          a.data.order - b.data.order ||
          a.id.localeCompare(b.id),
      )
      .map(async (group) => {
        const members = byGroup.get(group.id) ?? [];
        if (members.length === 0) return null;
        const { Content } = await render(group);
        return {
          group,
          members,
          Content,
          formattedTitle: await formatTitle(group.data.title),
        };
      }),
  )
).filter((group): group is NonNullable<typeof group> => group !== null);

// Computed last, against the groups that actually rendered, so a project
// pointing at a draft or missing group falls back to the main list instead of
// disappearing from the page.
const renderedGroupIds = new Set(groups.map((g) => g.group.id));
const ungrouped = withTitles.filter(
  (p) => !p.data.group || !renderedGroupIds.has(p.data.group.id),
);

/**
 * Groups lead: they are the most editorial thing on the page, so the reader
 * meets them first and the remainder becomes a named section rather than a
 * pile of leftovers. When nothing is grouped there is no section to name, and
 * project titles step back up to h2.
 */
const hasSections = groups.length > 0;
const projectTitleLevel = hasSections ? 3 : 2;

const OTHER_ID = "other-projects";
const icons = assignIcons([...groups.map((g) => g.group.id), OTHER_ID]);
---

<BaseLayout
  title="Projects - Tyler Butler"
  description="Projects by Tyler Butler - open source and personal projects."
>
  <section>
    <h1>Projects</h1>
    <p>
      A collection of projects I've worked on over the years, including open
      source contributions and personal experiments.
    </p>

    {groups.map(({ group, members, Content, formattedTitle }) => (
      <section class="project-group" aria-labelledby={`group-${group.id}`}>
        <div class="group-divider">
          <ConstellationIcon
            src={icons.get(group.id)!.url}
            slug={icons.get(group.id)!.slug}
            size={56}
          />
        </div>
        <div class="group-header">
          {group.data.logo && (
            <Image
              src={group.data.logo}
              alt={`${group.data.title} logo`}
              class="group-logo"
              width={72}
            />
          )}
          <h2
            id={`group-${group.id}`}
            class="section-heading"
            set:html={formattedTitle}
          />
          <div class="section-description"><Content /></div>
        </div>
        <ul class="projects-list">
          {members.map(project => (
            <ProjectCard
              project={project}
              formattedTitle={project.formattedTitle}
              titleLevel={3}
              showLogo={false}
            />
          ))}
        </ul>
      </section>
    ))}

    {ungrouped.length > 0 ? (
      hasSections ? (
        <section class="project-group" aria-labelledby={OTHER_ID}>
          <div class="group-divider">
            <ConstellationIcon
              src={icons.get(OTHER_ID)!.url}
              slug={icons.get(OTHER_ID)!.slug}
              size={56}
            />
          </div>
          <div class="group-header">
            <h2 id={OTHER_ID} class="section-heading">Everything Else</h2>
          </div>
          <ul class="projects-list">
            {ungrouped.map(project => (
              <ProjectCard
                project={project}
                formattedTitle={project.formattedTitle}
                titleLevel={projectTitleLevel}
              />
            ))}
          </ul>
        </section>
      ) : (
        <ul class="projects-list">
          {ungrouped.map(project => (
            <ProjectCard
              project={project}
              formattedTitle={project.formattedTitle}
              titleLevel={projectTitleLevel}
            />
          ))}
        </ul>
      )
    ) : groups.length === 0 && (
      <p>More projects coming soon...</p>
    )}
  </section>
</BaseLayout>

<style>
  .projects-list {
    list-style: none;
    padding: 0;
    margin: 2em 0;
  }

  .project-group {
    margin-top: 2em;
  }

  /* The signature divider does the structural work a rule used to do badly:
     a 2px border against the cards' 1px in the same color made the page's
     biggest break its least visible one. */
  .group-divider {
    display: flex;
    justify-content: center;
    margin: 3em 0 2em;
  }

  /* Stacked, not a flex row: every section heading then starts at the reading
     column's left edge whether or not its group has a logo, and the header can
     no longer overflow the container on narrow screens. */
  .group-logo {
    display: block;
    width: 72px;
    height: auto;
    margin-bottom: 0.75em;
  }

  .section-heading {
    margin: 0 0 0.5em 0;
    overflow-wrap: break-word;
  }

  .section-description {
    color: var(--text-light);
  }

  .section-description :global(p) {
    margin: 0 0 1em 0;
  }

  .section-description :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
