---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { NoteCounts } from "../lib/note-counts";
import type { Note } from "../lib/note-schema";
import { renderNote } from "../lib/render-note";
import NoteCard from "./NoteCard.astro";
import "../lib/styles/page-nav.css";
import {
  getNoteMonthUrl,
  getNotePathParts,
  getNoteYearUrl,
  monthLabel,
} from "../lib/note-utils";

interface Props {
  notes: Note[];
  counts: NoteCounts;
  year: string;
}
const { notes, counts, year } = Astro.props;
const years = [
  ...new Set(notes.map((note) => getNotePathParts(note).year)),
].sort();
const index = years.indexOf(year);
const prevYear = years[index - 1];
const nextYear = years[index + 1];
const items = notes
  .map((note) => ({ note, ...getNotePathParts(note) }))
  .filter((item) => item.year === year);

const groupedByMonth = new Map<string, typeof items>();
for (const item of items) {
  if (!groupedByMonth.has(item.month)) groupedByMonth.set(item.month, []);
  groupedByMonth.get(item.month)?.push(item);
}
const months = [...groupedByMonth.keys()].sort().reverse();

const renderedByMonth = await Promise.all(
  months.map(async (month) => {
    const monthItems = groupedByMonth.get(month) ?? [];
    const rendered = await Promise.all(
      monthItems.map(async (item) => {
        return { ...item, html: await renderNote(item.note) };
      }),
    );
    return { month, items: rendered };
  }),
);
---

<BaseLayout
  title={`Notes from ${year} - Tyler Butler`}
  description={`Short-form notes from ${year}.`}
  excludeFromSearch
>
  <section class="notes-page h-feed">
    <nav class="archive-crumbs">
      <a href="/notes/">Notes</a> / <span>{year}</span>
    </nav>
    <h1>Notes from {year}</h1>
    <p class="archive-count">
      {items.length} note{items.length === 1 ? "" : "s"}
    </p>

    {
      renderedByMonth.map(({ month, items: monthItems }) => (
        <section class="archive-month">
          <h2>
            <a href={getNoteMonthUrl(year, month)}>{monthLabel(month)}</a>
          </h2>
          <div class="notes-stream">
            {monthItems.map(({ note, html }) => (
              <NoteCard note={note} counts={counts}>
                <Fragment set:html={html} />
              </NoteCard>
            ))}
          </div>
        </section>
      ))
    }

    <nav class="article-nav">
      {
        prevYear && (
          <a href={getNoteYearUrl(prevYear)} class="nav-link">
            <span class="nav-arrow" aria-hidden="true">←</span>
            <span class="nav-text">{prevYear}</span>
          </a>
        )
      }
      {
        nextYear && (
          <a
            href={getNoteYearUrl(nextYear)}
            class="nav-link nav-link-next"
          >
            <span class="nav-text">{nextYear}</span>
            <span class="nav-arrow" aria-hidden="true">→</span>
          </a>
        )
      }
    </nav>
  </section>
</BaseLayout>

<style>
  .notes-page {
    max-width: 65ch;
    margin: 0 auto;
  }

  .archive-crumbs {
    font-size: 14px;
    color: var(--text-light);
    margin-bottom: 0.5rem;
  }

  .archive-crumbs a {
    color: var(--text-light);
    text-decoration: none;
  }

  .archive-crumbs a:hover {
    color: var(--accent);
  }

  .archive-count {
    color: var(--text-light);
    font-size: 14px;
    margin-top: 0.5rem;
  }

  .archive-month {
    margin-top: 2.5rem;
  }

  .archive-month h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
    border-bottom: 1px solid var(--border, #ddd);
    padding-bottom: 0.25rem;
  }

  .archive-month h2 a {
    color: var(--text);
    text-decoration: none;
  }

  .archive-month h2 a:hover {
    color: var(--accent);
  }

  .notes-stream {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
